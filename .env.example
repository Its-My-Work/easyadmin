PORT=3100
HOST=0.0.0.0
EASYADMIN_DATA=./data
# Ключ шифрования токенов панелей (если пусто — генерируется в data/secret.key)
EASYADMIN_SECRET=
# true, если сервис отдаётся по HTTPS через прокси
EASYADMIN_SECURE_COOKIES=false
EASYADMIN_SESSION_DAYS=30
EASYADMIN_CACHE_TTL_MS=10000
EASYADMIN_POLL_MS=60000
EASYADMIN_TIMEOUT_MS=15000
# Порог заполнения диска (%) для уведомления
EASYADMIN_DISK_ALERT_PCT=90
# Токен для GET /metrics (Prometheus). Пусто — метрики отключены
EASYADMIN_METRICS_TOKEN=
# Часовой пояс сервера (для расписаний), например Europe/Moscow: задаётся переменной TZ

# Публичный адрес EasyAdmin (нужен для SSO: redirect_uri = <адрес>/api/oidc/callback)
EASYADMIN_PUBLIC_URL=
# SSO (OpenID Connect): Keycloak, Authentik, Google, Azure AD, Okta и т.п.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_NAME=SSO
# Роль новых SSO-пользователей: viewer | operator | admin
OIDC_DEFAULT_ROLE=viewer
# Почты, получающие роль admin при первом входе (через запятую)
OIDC_ADMIN_EMAILS=
# Допустимые домены почты (через запятую); пусто — любые
OIDC_ALLOWED_DOMAINS=
# Пути WebSocket логов Easypanel (через запятую), если у вашей версии отличается
EASYPANEL_LOGS_PATHS=/ws/serviceLogs,/api/ws/serviceLogs,/ws/logs

# Язык уведомлений по умолчанию: ru | en (меняется в интерфейсе)
EASYADMIN_LANG=ru

# Срок сертификатов читается по TLS-соединению с доменом (панель его не отдаёт). Отключить: false
EASYADMIN_TLS_PROBE=true

# Каталог шаблонов Easypanel (Шаблоны → Каталог). Свой источник/зеркало: папка templates с list.json и <slug>/meta.yaml, index.ts.
# Код generate() из шаблонов выполняется на сервере в изолированном vm — при недоверии к источнику отключите каталог: off
# EASYADMIN_CATALOG=on
# EASYADMIN_CATALOG_URL=https://raw.githubusercontent.com/easypanel-io/templates/main/templates

# Консоль сервиса (терминал в контейнере). Отключить: off. Свои пути WebSocket — через запятую.
# EASYADMIN_CONSOLE=on
# EASYPANEL_CONSOLE_PATHS=/ws/serviceConsole,/ws/console
